# Environment: development | production | staging
ENVIRONMENT=development

# Production Database: Managed PostgreSQL (AWS RDS, Supabase, Neon, Railway)
# SQLite is ONLY used as local fallback in development
DATABASE_URL=sqlite:///./careerpilot.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://careerpilot:your_strong_password@db-host:5432/careerpilot
DB_SSLMODE=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security (CRITICAL FOR PRODUCTION: generate with `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Object Storage for Resumes (Production requires S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND=local
# For production:
# STORAGE_BACKEND=s3
# S3_BUCKET=careerpilot-resumes-prod
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
UPLOAD_DIR=./storage/resumes

# -----------------------------------------------------------------------------
# Course Aggregation Connectors (Official APIs & Free Educational Providers)
# -----------------------------------------------------------------------------

# 1. Generic JSON Source / Custom Catalog Feed
COURSE_SOURCE_URL=
COURSE_SOURCE_API_KEY=

# 2. Coursera Partner / Business API
# Request via: https://www.coursera.org/business or enterprise partner portal
COURSERA_CLIENT_ID=
COURSERA_CLIENT_SECRET=
COURSERA_BUSINESS_ID=
COURSERA_TOKEN_URL=https://api.coursera.com/oauth2/client_credentials/token
COURSERA_CONTENT_URL=

# 3. Udemy Affiliate / Partner API
# Request via: https://www.udemy.com/affiliate/ or instructor/business API
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

# 4. edX Discovery API
# https://discovery.edx.org/api/v1/ or enterprise feed
EDX_CATALOG_URL=
EDX_API_KEY=

# 5. MIT OpenCourseWare (Free metadata catalog)
# Default public feed: https://ocw.mit.edu/api/v0/
MIT_OCW_CATALOG_URL=

# 6. YouTube Data API v3 (For Free Educational Courses & Playlists)
# Generate from Google Cloud Console: Enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# AI Services — Phase 2 Only (Keep disabled during Phase 1)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_REQUESTS_PER_MINUTE=30
